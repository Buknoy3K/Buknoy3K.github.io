---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Products from '../components/sections/Products.astro';
import Market from '../components/sections/Market.astro';
import Traction from '../components/sections/Traction.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import BusinessModel from '../components/sections/BusinessModel.astro';
import Roadmap from '../components/sections/Roadmap.astro';
import Founder from '../components/sections/Founder.astro';
import CTA from '../components/sections/CTA.astro';
---

<!-- The page warms as it scrolls: highland fog and night, pine, resin, then ember. Saleng starts the fire. -->
<Base barAfterHero>
  <Hero />
  <Problem />
  <HowItWorks />
  <Products />
  <Market />
  <Traction />
  <Testimonials />
  <BusinessModel />
  <Roadmap />
  <Founder />
  <CTA />
</Base>
