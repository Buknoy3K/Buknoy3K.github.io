---
import '../styles/fonts.css';
// The home page: the campfire scene. The laptop shows the pitch page (/about/), the tablet the work desktop (/tablet/) and the phone its apps (/phone/),
// all live; clicking one zooms in so it can be used. The other things on the desk do something when clicked too
// (Sheets holds the card, printed quote and notebook overlays).
import Sheets from '../components/campfire/Sheets.astro';
import { brand } from '../config/site';

const pageTitle = `${brand.name}: ${brand.tagline}`;

// Along the bottom: the screens (each flies the camera onto it), then the things that open something over the scene.
// Each names its object in the scene (see desk() in models.ts and mountScreen in scene.ts).
const screensBar = [
  { name: 'laptop', what: 'Laptop', does: 'My website' },
  { name: 'tablet', what: 'Tablet', does: 'My work' },
  { name: 'phone', what: 'Phone', does: 'My apps' },
];
const icon = (d: string) =>
  `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const thingsBar = [
  { name: 'card', does: 'Take my card', icon: icon('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 10h6M7 14h4"/>') },
  { name: 'diary', does: 'Read client notes', icon: icon('<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11"/>') },
  { name: 'printerSet', does: 'Print a quote', icon: icon('<path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/>') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={brand.description} />
    <meta name="theme-color" content="#e6e9ed" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={brand.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.site && <link rel="canonical" href={Astro.site} />}
    {Astro.site && <meta property="og:url" content={Astro.site} />}
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <canvas id="campfire" aria-label="3D scene: a desk of devices with a miniature fireplace. The laptop shows the Saleng Works website, the tablet shows past work and the phone shows apps."></canvas>
    <header class="hero">
      <h1>{brand.name}</h1>
      <p>Systems &amp; Automation</p>
    </header>
    <nav class="bar" aria-label="On the desk">
      {screensBar.map((b) => (
        <button type="button" class="pill" data-activate={b.name}><b>{b.what}</b> {b.does}</button>
      ))}
      {thingsBar.map((b) => (
        <button type="button" class="link" data-activate={b.name}><Fragment set:html={b.icon} />{b.does}</button>
      ))}
    </nav>
    <div class="corner">
      <button type="button" class="fire" aria-pressed="false" aria-label="Light the fireplace" title="Light the fireplace">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c1 3 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5 0 1.5.8 2.6 2 3-.8-3 0-6 1-8.5z" /></svg>
      </button>
    </div>
    <button type="button" class="back" hidden>&larr; Back to the campfire</button>
    <Sheets />

    <script>
      import { mountCampfire } from '../scripts/campfire/scene';
      import { mountSheets } from '../scripts/campfire/sheets';
      const sheets = mountSheets();
      const back = document.querySelector<HTMLButtonElement>('.back')!;
      const fireButton = document.querySelector<HTMLButtonElement>('.fire')!;
      // Lighting the fire turns the page to night along with the scene
      const showFire = (on: boolean) => {
        fireButton.setAttribute('aria-pressed', String(on));
        fireButton.title = fireButton.ariaLabel = on ? 'Put out the fireplace' : 'Light the fireplace';
        document.body.classList.toggle('night', on);
        document.querySelector('meta[name="theme-color"]')!.setAttribute('content', on ? '#07080a' : '#e6e9ed');
      };
      const { exitFocus, toggleFire, activate } = mountCampfire(
        document.getElementById('campfire') as HTMLCanvasElement,
        '/about/',
        '/tablet/',
        '/phone/',
        (focused) => {
          document.body.classList.toggle('focused', focused);
          back.hidden = !focused;
        },
        showFire,
        sheets.open,
      );
      fireButton.addEventListener('click', () => showFire(toggleFire()));
      back.addEventListener('click', exitFocus);
      document.querySelectorAll<HTMLButtonElement>('[data-activate]').forEach((b) => b.addEventListener('click', () => activate(b.dataset.activate!)));
    </script>

    <style is:global>
      /* Day (white) until the fireplace is lit, then night; everything eases across with the scene */
      body {
        --bg: #e6e9ed; --ink: #1c1915; --muted: #6f675e; --line: #e2ded7; --chip: #ffffffd9; --accent: #1f9d64;
        transition: background-color 1.2s;
      }
      body.night { --bg: #07080a; --ink: #f3ece2; --muted: #a0978d; --line: #2a2d31; --chip: #121417cc; --accent: #3ecf8e; }
      html, body { margin: 0; height: 100%; background: var(--bg); overflow: hidden; }
      #campfire { position: relative; z-index: 1; display: block; width: 100vw; height: 100svh; touch-action: none; }
      /* Title over the scene, and the row of things to try along the bottom; both step aside while a screen is open */
      .hero {
        position: fixed; top: clamp(44px, 10vh, 96px); left: 16px; right: 16px; z-index: 2; pointer-events: none;
        display: flex; flex-direction: column; align-items: center; text-align: center;
      }
      .hero h1 {
        margin: 0; font: 600 clamp(40px, 5vw, 68px)/1.05 Inter, system-ui, sans-serif; letter-spacing: -0.045em;
        color: var(--ink); transition: color 1.2s;
      }
      .hero p {
        margin: 12px 0 0; font: 400 clamp(16px, 1.3vw, 19px)/1.4 Inter, system-ui, sans-serif; letter-spacing: -0.01em;
        color: var(--muted); transition: color 1.2s;
      }
      .bar {
        position: fixed; left: 50%; bottom: 20px; z-index: 2; transform: translateX(-50%);
        display: flex; align-items: center; gap: 8px; max-width: calc(100vw - 128px); overflow-x: auto; scrollbar-width: none;
      }
      .bar button {
        flex: none; display: inline-flex; align-items: center; gap: 7px; cursor: pointer; white-space: nowrap;
        font: 400 15px/1 Inter, system-ui, sans-serif; letter-spacing: -0.01em; color: var(--muted); background: none; border: 1px solid transparent;
        padding: 12px 18px; border-radius: 999px; transition: color 0.15s, border-color 0.15s, background-color 1.2s;
      }
      .bar .pill { border-color: var(--line); background: var(--chip); }
      .bar .pill b { color: var(--ink); font-weight: 500; }
      .bar .link { padding-inline: 12px; }
      .bar button:hover { color: var(--accent); border-color: var(--accent); }
      .bar .link:hover { border-color: transparent; }
      .bar button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      @media (max-width: 720px) {
        .bar { left: 16px; right: 72px; max-width: none; transform: none; bottom: 16px; }
        .bar button { font-size: 14px; padding: 10px 14px; }
      }
      .corner { position: fixed; right: 16px; bottom: 16px; z-index: 2; }
      .corner button, .back {
        border: 1px solid var(--line); background: var(--chip); color: var(--ink); cursor: pointer; transition: color 0.15s, border-color 0.15s, background-color 1.2s;
      }
      .corner button { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; }
      .corner button:hover, .back:hover { border-color: var(--accent); color: var(--accent); }
      .corner .fire[aria-pressed='true'] { color: #ff9a4a; border-color: #ff9a4a; }
      .corner button:focus-visible, .back:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .hero, .bar, .corner { transition: opacity 0.3s; }
      /* While the camera swoops in and the desk fills up, the title and buttons wait, then rise in */
      @media (prefers-reduced-motion: no-preference) {
        .hero { animation: rise 0.9s 2.6s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
        .bar, .corner { animation: rise 0.9s 3s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
      }
      @keyframes rise { from { opacity: 0; translate: 0 12px; } }
      .focused .hero, .focused .bar, .focused .corner { opacity: 0; pointer-events: none; }
      .back {
        position: fixed; left: 16px; top: 16px; z-index: 2; padding: 8px 14px; border-radius: 999px;
        font: 14px/1.2 system-ui, sans-serif;
      }
    </style>
  </body>
</html>
