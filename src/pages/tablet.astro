---
// The tablet in the campfire scene shows this page: a small desktop with Work (every project, each with a working
// demo) and Contact. It also works on its own at /tablet.
import { brand, founder } from '../config/site';
const owner = { name: founder.name, role: founder.role, initials: founder.initials, email: brand.email, location: brand.location };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Work | {founder.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main id="desk" data-owner={JSON.stringify(owner)}></main>
    <script>
      import { mountDesktop } from '../scripts/tablet/os';
      const desk = document.getElementById('desk')!;
      mountDesktop(desk, JSON.parse(desk.dataset.owner!));
    </script>

    <style is:global>
      :root {
        --bg: #f4f2f8; --win: #ffffff; --line: #e4e0ec; --text: #1d1a26; --muted: #6b6680; --purple: #7c3aed; --purple-d: #6d28d9; --a: var(--purple);
        --ok: #4ade80; --warn: #fbbf24; --bad: #f87171; --info: #93c5fd;
        color-scheme: light;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--text); font: 14px/1.45 Inter, system-ui, sans-serif; }
      button, input, select, textarea { font: inherit; color: inherit; }
      button { cursor: pointer; }
      button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--purple); outline-offset: 2px; }
      #desk {
        position: fixed; inset: 0;
        background:
          radial-gradient(60% 70% at 15% 10%, #e9e4fb 0, transparent 70%),
          radial-gradient(55% 60% at 90% 95%, #fbe8de 0, transparent 70%),
          linear-gradient(160deg, #f7f6fb, #efedf4);
      }

      /* Menu bar */
      .menubar {
        position: absolute; inset: 0 0 auto; height: 30px; display: flex; align-items: center; gap: 4px; padding: 0 14px;
        background: #ffffffcc; border-bottom: 1px solid #00000010; font-size: 13px;
      }
      .menubar b { margin-right: 10px; }
      .menubar button { background: none; border: 0; padding: 4px 9px; border-radius: 6px; }
      .menubar button:hover { background: #0000000d; }
      .clock { margin-left: auto; color: var(--muted); }

      /* Desktop icons */
      .icons { position: absolute; right: 26px; top: 56px; display: grid; gap: 18px; }
      .d-icon { display: grid; justify-items: center; gap: 6px; background: none; border: 0; font-size: 12px; color: var(--text); }
      .d-icon span { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 14px; background: #fff; border: 1px solid var(--line); color: var(--purple); box-shadow: 0 4px 12px #1d1a260d; }
      .d-icon:hover span { border-color: var(--purple); }

      /* Dock */
      .dock {
        position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 9000; display: flex; align-items: center; gap: 8px;
        padding: 8px; border-radius: 18px; background: #ffffffb3; border: 1px solid #ffffff; box-shadow: 0 10px 30px #1d1a2620;
      }
      .dock-i { position: relative; display: grid; place-items: center; width: 46px; height: 46px; border: 0; border-radius: 12px; background: var(--c); color: #fff; transition: transform 0.15s; }
      .dock-i:hover { transform: translateY(-3px); }
      .dock-i.open::after { content: ''; position: absolute; bottom: -6px; width: 4px; height: 4px; border-radius: 50%; background: #6b6680; }
      .dock-sep { width: 1px; height: 32px; background: #0000001a; margin: 0 2px; }
      .tip {
        position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%); white-space: nowrap; pointer-events: none;
        padding: 4px 8px; border-radius: 6px; background: #1d1a26; color: #fff; font-size: 12px; opacity: 0; transition: opacity 0.15s;
      }
      .dock-i:hover .tip, .dock-i:focus-visible .tip { opacity: 1; }

      /* Windows */
      .win {
        position: absolute; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; overflow: hidden;
        background: var(--win); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 24px 60px #1d1a2630;
      }
      .win.work { top: 50px; width: min(940px, calc(100vw - 150px)); height: calc(100vh - 150px); }
      .win.big { top: 40px; width: min(1100px, calc(100vw - 40px)); height: calc(100vh - 130px); }
      .win.small { top: 70px; width: 420px; }
      .bar { position: relative; flex: none; height: 38px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--line); background: #faf9fc; cursor: grab; user-select: none; }
      .bar-title { font-size: 13px; font-weight: 500; color: var(--muted); }
      .lights { position: absolute; left: 14px; display: flex; gap: 8px; }
      .lights > * { width: 12px; height: 12px; border-radius: 50%; border: 0; padding: 0; background: #dedbe6; }
      .lights .l-close { background: #ff5f57; }
      .win-body { flex: 1; min-height: 0; overflow: auto; }
      .win-fill { flex: 1; min-height: 0; display: flex; flex-direction: column; }
      .demo-note { flex: none; display: flex; justify-content: space-between; align-items: center; padding: 6px 14px; font-size: 12px; color: var(--muted); border-bottom: 1px solid var(--line); }
      .demo { overflow: hidden; }
      .front { overflow: auto; }
      .note-left { display: flex; align-items: center; gap: 10px; }
      .note-back { padding: 2px 9px; border-radius: 6px; border: 1px solid var(--line); background: #fff; font-size: 12px; color: var(--text); }
      .demo-note .chip { background: #f1eff6; color: var(--muted); }
      .note-back:hover { border-color: var(--purple); }
      .demo-frame { display: block; width: 100%; height: 100%; border: 0; background: #0b1120; }
      .win-body:has(> .demo-frame) { overflow: hidden; }
      .thumb-live .demo-frame { height: 640px; }

      /* Front pages (each business's website) */
      .fp { min-height: 100%; background: var(--fp-bg); color: var(--fp-ink); font-size: 14px; }
      .fp.serif h1, .fp.serif .fp-brand, .fp.serif .fp-feats b { font-family: Georgia, 'Times New Roman', serif; }
      .fp button { cursor: pointer; }
      .fp-nav { display: flex; align-items: center; gap: 24px; padding: 18px 40px; border-bottom: 1px solid var(--fp-line); }
      .fp-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; }
      .fp-mark { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; background: var(--fp-accent); color: var(--fp-on); font: 700 12px/1 Inter, sans-serif; }
      .fp-links { display: flex; gap: 4px; margin-left: auto; }
      .fp-links button { border: 0; background: none; padding: 6px 10px; border-radius: 6px; color: var(--fp-muted); font-size: 13px; }
      .fp-links button:hover { color: var(--fp-ink); }
      .fp-login { border: 1px solid var(--fp-ink); background: none; color: var(--fp-ink); border-radius: 999px; padding: 7px 16px; font-size: 13px; font-weight: 600; }
      .fp-login:hover { background: var(--fp-ink); color: var(--fp-bg); }
      .fp-hero { display: grid; grid-template-columns: 1fr 470px; gap: 40px; align-items: center; padding: 48px 40px 40px; }
      .fp-eyebrow { display: inline-block; font-size: 12px; font-weight: 600; color: var(--fp-accent); letter-spacing: 0.02em; }
      .fp h1 { margin: 12px 0 14px; font-size: 40px; line-height: 1.08; letter-spacing: -0.025em; font-weight: 700; }
      .fp-copy p { margin: 0 0 24px; color: var(--fp-muted); font-size: 15px; line-height: 1.6; max-width: 440px; }
      .fp-ctas { display: flex; flex-wrap: wrap; gap: 10px; }
      .fp-btn { border: 1px solid var(--fp-accent); background: var(--fp-accent); color: var(--fp-on); border-radius: 999px; padding: 11px 20px; font-weight: 600; font-size: 14px; }
      .fp-btn:hover { filter: brightness(1.08); }
      .fp-btn.ghost { background: none; color: var(--fp-ink); border-color: var(--fp-line); }
      .fp-btn.ghost:hover { border-color: var(--fp-ink); }
      .fp-shot { position: relative; display: block; width: 470px; height: 323px; padding: 0; overflow: hidden; border-radius: 12px; border: 1px solid var(--fp-line); background: #0d0b13; box-shadow: 0 24px 50px #0004; text-align: left; transition: transform 0.2s; }
      .fp-shot:hover { transform: translateY(-3px); }
      .fp-shot-bar { position: absolute; inset: 0 0 auto; height: 22px; display: flex; gap: 5px; align-items: center; padding: 0 10px; background: #1a1724; z-index: 1; }
      .fp-shot-bar i { width: 7px; height: 7px; border-radius: 50%; background: #4a4460; }
      .fp-shot-live { position: absolute; left: 0; top: 22px; width: 1000px; height: 640px; transform: scale(0.47); transform-origin: 0 0; pointer-events: none; }
      .fp-feats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding: 0 40px 36px; }
      .fp-feats div { padding: 18px 20px; border-radius: 12px; background: var(--fp-card); border: 1px solid var(--fp-line); }
      .fp-feats b { display: block; margin-bottom: 6px; font-size: 15px; }
      .fp-feats p { margin: 0; color: var(--fp-muted); font-size: 13px; line-height: 1.55; }
      .fp-foot { display: flex; justify-content: space-between; padding: 16px 40px; border-top: 1px solid var(--fp-line); color: var(--fp-muted); font-size: 12px; }

      /* Work window */
      .work-body { padding: 30px 32px 36px; }
      .work-body h1 { margin: 0; font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
      .lede { margin: 6px 0 24px; color: var(--muted); }
      .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px 16px; }
      .card-p { display: grid; align-content: start; gap: 3px; padding: 0; border: 0; background: none; text-align: left; }
      .card-p b { margin-top: 8px; font-weight: 600; }
      .card-p small { color: var(--muted); font-size: 12px; line-height: 1.35; }
      .thumb { position: relative; aspect-ratio: 1000 / 640; overflow: hidden; border-radius: 10px; border: 1px solid #1d1a2612; background: #fff; transition: border-color 0.15s, transform 0.15s; }
      .card-p:hover .thumb { border-color: var(--purple); transform: translateY(-2px); }
      .thumb-live { position: absolute; left: 0; top: 0; transform-origin: 0 0; pointer-events: none; }
      .tag { position: absolute; right: 7px; top: 7px; padding: 2px 8px; border-radius: 999px; background: #ffffffe6; font-size: 10px; font-weight: 500; color: #3b3650; }
      .poster { display: grid; place-content: center; justify-items: center; gap: 10px; background: var(--pb); color: var(--pf); }
      .poster-mark { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 16px; background: var(--pf); color: var(--pb); }
      .poster-name { font-weight: 700; font-size: 15px; letter-spacing: -0.01em; }
      .poster.serif .poster-name { font-family: Georgia, 'Times New Roman', serif; font-size: 16px; }

      /* Contact */
      .contact { padding: 22px; display: grid; gap: 16px; }
      .me { display: flex; gap: 12px; align-items: center; }
      .me b { display: block; font-size: 16px; }
      .me small { color: var(--muted); }
      .avatar { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, #8b5cf6, #5b21b6); font-weight: 700; }
      .facts-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; color: var(--text); }
      .facts-list li { display: flex; gap: 10px; align-items: center; }
      .facts-list svg { color: var(--purple); }
      .contact-form { display: grid; gap: 10px; }
      .contact .field input, .contact .field textarea { background: #faf9fc; border-color: var(--line); }
      .contact .btn.primary { color: #fff; }

      .toast {
        position: fixed; left: 50%; bottom: 96px; z-index: 99999; transform: translate(-50%, 8px); opacity: 0; transition: 0.25s;
        padding: 9px 14px; border-radius: 10px; background: #1d1a26; color: #fff; font-size: 13px; box-shadow: 0 10px 30px #1d1a2640;
      }
      .toast.in { opacity: 1; transform: translate(-50%, 0); }

      /* ---- Demo apps ---- */
      .app { --a: #a78bfa; --text: #ece9f5; --muted: #9a94b0; --line: #2a2540; color-scheme: dark; display: grid; grid-template-columns: 200px 1fr; height: 100%; background: #110f18; color: var(--text); font-size: 13px; }
      .app.single { grid-template-columns: 1fr; }
      .side { display: flex; flex-direction: column; gap: 18px; padding: 16px 10px; background: #0d0b13; border-right: 1px solid #241f33; }
      .brand { display: flex; align-items: center; gap: 10px; padding: 0 6px; }
      .brand b { display: block; font-size: 14px; }
      .brand small { color: var(--muted); font-size: 11px; }
      .mono-logo { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 9px; background: var(--a); color: #0d0b13; font-weight: 700; font-size: 12px; }
      .nav { display: grid; gap: 2px; }
      .nav button { display: flex; align-items: center; gap: 9px; padding: 8px 10px; border: 0; border-radius: 8px; background: none; color: #bdb6d3; text-align: left; }
      .nav.dense button { padding: 6px 10px; font-size: 12px; }
      .nav button:hover { background: #ffffff0a; }
      .nav button[aria-current] { background: color-mix(in srgb, var(--a) 18%, transparent); color: #fff; }
      .nav button[aria-current] svg { color: var(--a); }
      .side-foot { margin-top: auto; display: flex; align-items: center; gap: 8px; padding: 0 8px; font-size: 11px; color: var(--muted); }
      .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); }
      .main { min-width: 0; overflow: auto; padding: 18px 22px 24px; }
      .main.split { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; overflow: hidden; }
      .main.pos { display: grid; grid-template-columns: 1fr 300px; gap: 16px; overflow: hidden; }
      .pane { min-height: 0; overflow: auto; display: flex; flex-direction: column; gap: 12px; }
      .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
      .pane .head { margin-bottom: 0; }
      .head h2 { margin: 0; font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
      .head p { margin: 2px 0 0; color: var(--muted); font-size: 12px; }
      h3 { margin: 0 0 10px; font-size: 14px; font-weight: 600; }
      h4 { margin: 16px 0 8px; font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
      .muted { color: var(--muted); }
      .sm { font-size: 11px; }
      .right { text-align: right; }

      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 12px; border-radius: 8px; border: 1px solid #332c48; background: #1d1929; font-weight: 500; white-space: nowrap; }
      .btn:hover:not(:disabled) { border-color: var(--a); }
      .btn:disabled { opacity: 0.4; cursor: default; }
      .btn.primary { background: var(--a); border-color: var(--a); color: #0d0b13; font-weight: 600; }
      .btn.ghost { background: none; }
      .btn.sm { padding: 4px 9px; font-size: 12px; }
      .btn.lg { padding: 13px; font-size: 15px; }
      .btn.full { width: 100%; }
      .btn.on { border-color: var(--a); color: var(--a); }
      .row-btns { display: inline-flex; gap: 6px; justify-content: flex-end; }

      .chip { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 500; white-space: nowrap; background: #ffffff10; color: #c9c2de; }
      .chip.ok { background: #4ade801f; color: var(--ok); }
      .chip.warn { background: #fbbf241f; color: var(--warn); }
      .chip.bad { background: #f871712b; color: var(--bad); }
      .chip.info { background: #93c5fd1f; color: var(--info); }
      .chips { display: flex; flex-wrap: wrap; gap: 6px; }

      .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 14px; }
      .tile { display: grid; gap: 2px; padding: 12px 14px; border-radius: 10px; background: #18152280; border: 1px solid #262036; }
      .tile span { font-size: 12px; color: var(--muted); }
      .tile b { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
      .tile small { font-size: 11px; color: var(--muted); }
      .tile.bad b { color: var(--bad); }

      .cols { display: flex; gap: 14px; align-items: flex-start; }
      .card { padding: 14px 16px; border-radius: 10px; background: #16131f; border: 1px solid #262036; }
      .grow { flex: 1; min-width: 0; }
      .side-card { width: 260px; flex: none; }
      .list-card { width: 250px; flex: none; padding: 8px; }

      .t { width: 100%; border-collapse: collapse; }
      .t th { text-align: left; font-size: 11px; font-weight: 500; color: var(--muted); padding: 0 8px 8px; border-bottom: 1px solid #262036; }
      .t td { padding: 8px; border-bottom: 1px solid #1f1a2c; vertical-align: top; }
      .t tr:last-child td { border-bottom: 0; }
      .t td.late { color: var(--bad); }
      .t .nw { white-space: nowrap; }

      .checks { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 10px; }
      .checks label { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; }
      .checks input { margin-top: 3px; accent-color: var(--a); }
      .checks b { display: block; font-weight: 500; font-size: 12px; }
      .checks small { color: var(--muted); font-size: 12px; }
      .checks small.done { text-decoration: line-through; }

      .pick { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
      .pick button { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 10px; border: 0; border-radius: 8px; background: none; text-align: left; }
      .pick button:hover { background: #ffffff08; }
      .pick button[aria-current] { background: color-mix(in srgb, var(--a) 16%, transparent); }
      .pick small { display: block; color: var(--muted); font-size: 11px; }
      .detail-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
      .detail-head h3 { margin: 0 6px 0 0; font-size: 17px; }
      .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 16px 0 0; }
      .facts dt { font-size: 11px; color: var(--muted); }
      .facts dd { margin: 2px 0 0; }

      .cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
      .cal-w { font-size: 11px; color: var(--muted); padding: 0 4px 4px; }
      .cal-cell { min-height: 66px; display: flex; flex-direction: column; align-items: flex-start; gap: 3px; padding: 5px; border-radius: 7px; background: #1a1725; border: 1px solid transparent; text-align: left; }
      .cal-cell.empty { background: none; }
      .cal-cell.on { border-color: var(--a); }
      .cal-cell.today .cal-n { background: var(--a); color: #0d0b13; }
      .cal-n { font-size: 11px; padding: 0 5px; border-radius: 999px; }
      .cal-f { font-size: 10px; padding: 0 5px; border-radius: 4px; background: color-mix(in srgb, var(--a) 22%, transparent); color: #e4dcff; }
      .due-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
      .due-list li { display: flex; justify-content: space-between; gap: 8px; }
      .due-list small { display: block; color: var(--muted); font-size: 11px; }

      /* DOC GEN */
      .paste { flex: 1; min-height: 220px; resize: none; padding: 12px; border-radius: 10px; background: #0d0b13; border: 1px solid #262036; font: 12px/1.6 ui-monospace, Consolas, monospace; color: #cfe; }
      .paper-wrap { background: #1a1725; border-radius: 10px; padding: 18px; }
      .paper { background: #fbfaf6; color: #1b1b1b; padding: 26px 28px; border-radius: 4px; font: 11px/1.55 Georgia, serif; box-shadow: 0 6px 20px #0006; }
      .paper-head { display: grid; justify-items: center; text-align: center; border-bottom: 2px solid #1b1b1b; padding-bottom: 8px; }
      .paper-head b { font-size: 14px; }
      .paper h4 { text-align: center; color: #1b1b1b; font-size: 13px; letter-spacing: 0.08em; margin: 14px 0 10px; }
      .paper table { width: 100%; border-collapse: collapse; margin: 8px 0; }
      .paper th, .paper td { border: 1px solid #999; padding: 3px 6px; text-align: left; }
      .paper tfoot td { font-weight: 700; }
      .sign { margin-top: 22px; display: grid; justify-items: end; }
      .sign span { border-top: 1px solid #1b1b1b; padding-top: 2px; min-width: 150px; text-align: center; font-weight: 700; }

      /* POS / menus */
      .tiles-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
      .tiles-grid.two { grid-template-columns: repeat(2, 1fr); }
      .item { display: grid; gap: 2px; padding: 12px; border-radius: 10px; background: #1a1725; border: 1px solid #262036; text-align: left; }
      .item:hover:not(:disabled) { border-color: var(--a); }
      .item:disabled { opacity: 0.4; }
      .item span { color: var(--a); font-weight: 600; }
      .item small { color: var(--muted); font-size: 11px; }
      .item small.low { color: var(--warn); }
      .item small.count { color: var(--a); }
      .cart { padding: 14px; border-radius: 12px; background: #16131f; border: 1px solid #262036; }
      .lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
      .lines li { display: grid; grid-template-columns: 1fr auto 60px; align-items: center; gap: 8px; }
      .lines b { text-align: right; }
      .qty { display: inline-flex; align-items: center; gap: 6px; }
      .qty button { display: grid; place-items: center; width: 22px; height: 22px; padding: 0; border-radius: 6px; border: 1px solid #332c48; background: none; }
      .sum { display: flex; justify-content: space-between; align-items: baseline; padding-top: 10px; border-top: 1px solid #262036; margin-top: auto; }
      .cash + .sum { margin-top: 0; }
      .sum b { font-size: 18px; }
      .sum.big b { font-size: 24px; color: var(--a); }
      .cash { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }

      /* Kiosk and boards */
      .kiosk { padding: 20px; border-radius: 14px; background: #16131f; border: 1px solid #262036; }
      .kiosk h2 { margin: 0; font-size: 22px; }
      .kiosk p { margin: 0; }
      .kiosk-top { display: flex; align-items: center; gap: 10px; }
      .opts { display: grid; gap: 8px; }
      .opt { display: flex; justify-content: space-between; padding: 12px 14px; border-radius: 10px; border: 1px solid #332c48; background: #1d1929; text-align: left; }
      .opt.on { border-color: var(--a); background: color-mix(in srgb, var(--a) 14%, #1d1929); }
      .opt small { color: var(--muted); }
      .stepper { display: flex; align-items: center; gap: 16px; }
      .stepper button { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; border: 1px solid #332c48; background: #1d1929; }
      .stepper b { font-size: 22px; min-width: 70px; text-align: center; }
      .board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: start; }
      .board.kds { grid-template-columns: repeat(2, 1fr); }
      .lane { display: grid; gap: 8px; padding: 8px; border-radius: 10px; background: #16131f; min-height: 200px; align-content: start; }
      .lane h4 { margin: 0 0 2px; display: flex; justify-content: space-between; }
      .ticket { display: grid; gap: 6px; padding: 10px; border-radius: 8px; background: #1f1b2e; border: 1px solid #2c2640; }
      .ticket small { font-size: 11px; color: var(--muted); }
      .ticket ul { margin: 0; padding-left: 16px; }
      .ticket.slow { border-color: var(--bad); }
      .ticket.slow .ticket-top span { color: var(--bad); }
      .ticket-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
      .pane.dark { padding: 14px; border-radius: 12px; background: #0c0a11; }
      .select select, .field select, .field input, .field textarea { padding: 6px 8px; border-radius: 8px; border: 1px solid #332c48; background: #0f0d16; }
      .field { display: grid; gap: 4px; font-size: 12px; color: var(--muted); margin-bottom: 10px; }
      .field input, .field textarea, .field select { color: var(--text); font-size: 13px; }

      /* Chat */
      .chat { padding: 0; border-radius: 12px; background: #16131f; border: 1px solid #262036; overflow: hidden; gap: 0; }
      .chat-top { display: flex; gap: 10px; align-items: center; padding: 12px 14px; border-bottom: 1px solid #262036; }
      .chat-top small { display: block; color: var(--ok); font-size: 11px; }
      .msgs { flex: 1; overflow: auto; display: flex; flex-direction: column; gap: 8px; padding: 14px; }
      .msg { max-width: 78%; padding: 8px 12px; border-radius: 16px; background: #262138; align-self: flex-start; }
      .msg.me { align-self: flex-end; background: var(--a); color: #fff; }
      .msg.typing { color: var(--muted); letter-spacing: 2px; }
      .quick { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 14px 14px; }
      .fleet { display: grid; gap: 4px; }
      .fleet-d { font-size: 11px; color: var(--muted); text-align: center; }
      .fleet-c { font-size: 12px; align-self: center; }
      .slot { padding: 10px 0; border-radius: 6px; text-align: center; font-size: 11px; background: #4ade801a; color: var(--ok); }
      .slot.taken { background: #ffffff0d; color: var(--muted); }
      .slot.new { background: var(--a); color: #fff; font-weight: 600; }

      /* Boarding house rooms */
      .rooms { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
      .room { display: grid; gap: 4px; padding: 12px; border-radius: 10px; background: #16131f; border: 1px solid #262036; }
      .room.late { border-color: #f8717166; }
      .room small { font-size: 11px; }

      /* Trading post */
      .prices { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 14px; }
      .price { display: grid; grid-template-columns: 1fr auto; padding: 10px 12px; border-radius: 10px; background: #16131f; border: 1px solid #262036; }
      .price span { grid-column: 1 / -1; color: var(--muted); font-size: 12px; }
      .price b { font-size: 18px; }
      .price small { align-self: center; font-size: 11px; }
      .up { color: var(--ok); }
      .down { color: var(--bad); }
    </style>
  </body>
</html>
