---
// Work-in-progress campfire scene (step 1: figures only, free camera). Not linked from the site yet.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Campfire | Saleng Labs</title>
  </head>
  <body>
    <canvas id="campfire" aria-label="3D campfire scene with a kiosk, a desk of devices, a log table, a jade plant and a bonsai"></canvas>
    <p class="hint">Drag to look around. Scroll or pinch to zoom in.</p>
    <div class="zoom" role="group" aria-label="Zoom">
      <button type="button" data-zoom="0.25" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="-0.25" aria-label="Zoom out">&minus;</button>
    </div>

    <script>
      import { mountCampfire } from '../scripts/campfire/scene';
      const { zoomBy } = mountCampfire(document.getElementById('campfire') as HTMLCanvasElement);
      document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) => b.addEventListener('click', () => zoomBy(Number(b.dataset.zoom))));
    </script>

    <style is:global>
      html, body { margin: 0; height: 100%; background: #07080a; overflow: hidden; }
      #campfire { display: block; width: 100vw; height: 100svh; touch-action: none; }
      .hint {
        position: fixed; left: 16px; bottom: 16px; margin: 0;
        font: 13px/1.4 system-ui, sans-serif; color: #8b8f96;
      }
      .zoom { position: fixed; right: 16px; bottom: 16px; display: flex; flex-direction: column; gap: 6px; }
      .zoom button {
        width: 40px; height: 40px; border-radius: 50%; border: 1px solid #2a2d31; background: #121417cc;
        color: #d6d8db; font: 20px/1 system-ui, sans-serif; cursor: pointer;
      }
      .zoom button:hover { border-color: #3ecf8e; color: #3ecf8e; }
      .zoom button:focus-visible { outline: 2px solid #3ecf8e; outline-offset: 2px; }
    </style>
  </body>
</html>
