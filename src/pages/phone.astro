---
// The phone in the campfire scene shows this page: a home screen with four apps (two demos, two ideas).
// It also works on its own at /phone.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Apps | Saleng Labs</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Red+Hat+Mono:wght@500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main id="phone"></main>
    <script>
      import { mountPhone } from '../scripts/phone/apps';
      mountPhone(document.getElementById('phone')!);
    </script>

    <style is:global>
      :root { --ink: #16181b; --muted: #747880; --line: #e7e7ea; --card: #fff; --bg: #f3f3f5; --ok: #13794a; --ember: #c0222f; color-scheme: light; }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; overflow: hidden; color: var(--ink); font: 15px/1.4 Inter, system-ui, sans-serif; }
      button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
      button:focus-visible { outline: 2px solid var(--a, #0a7cff); outline-offset: 2px; }
      .mono { font-family: 'Red Hat Mono', ui-monospace, monospace; }

      #phone {
        position: fixed; inset: 0; display: grid; grid-template-rows: 44px 1fr 22px;
        background: #fff;
      }
      .status { display: flex; justify-content: space-between; align-items: center; padding: 0 26px; color: var(--ink); font-size: 15px; z-index: 2; }
      .in-app .status { background: var(--top); color: #fff; }
      .in-app .batt { border-color: #ffffffb3; }
      .in-app { background: var(--bg) !important; }
      .sys { display: flex; align-items: center; gap: 6px; }
      .bars { display: flex; align-items: flex-end; gap: 2px; height: 10px; }
      .bars i { width: 3px; background: currentColor; border-radius: 1px; }
      .batt { width: 24px; height: 11px; border: 1.5px solid #16181bb3; border-radius: 3px; padding: 1px; }
      .batt i { display: block; width: 70%; height: 100%; background: currentColor; border-radius: 1px; }
      .screen { overflow: hidden; display: flex; flex-direction: column; min-height: 0; }
      .home-bar { width: 134px; height: 5px; margin: 6px auto 0; border-radius: 99px; background: var(--ink); cursor: pointer; }

      /* Home screen */
      .home { padding: 8px 18px 4px; display: flex; flex-direction: column; gap: 18px; height: 100%; }
      .greet small { color: var(--muted); font-size: 13px; font-weight: 500; }
      .greet h1 { margin: 2px 0 0; font-size: 28px; line-height: 1.1; font-weight: 700; letter-spacing: -0.03em; }
      .home h2 { display: flex; justify-content: space-between; align-items: baseline; margin: 0 2px 10px; font-size: 13px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
      .home h2 small { text-transform: none; letter-spacing: 0; font-weight: 500; color: var(--ember); }

      .widgets { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .w { display: flex; flex-direction: column; justify-content: space-between; gap: 10px; height: 158px; padding: 14px; border-radius: 22px; }
      .w-txt { display: grid; }
      .w-txt b { font-size: 15px; }
      .w-txt small { font-size: 12px; opacity: 0.75; }
      .weather { background: linear-gradient(165deg, #4a90d9, #8dbbe8); color: #fff; }
      .w-top { display: flex; justify-content: space-between; align-items: center; }
      .w-top b { font-size: 34px; font-weight: 300; line-height: 1; letter-spacing: -0.04em; }
      .hours { display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; }
      .hours span { display: grid; justify-items: center; }
      .hours small { font-size: 10px; font-weight: 500; opacity: 0.8; }
      .brand { background: #151a16; color: #f1efe8; position: relative; overflow: hidden; }
      .brand::after { content: ''; position: absolute; right: -40px; bottom: -50px; width: 140px; height: 140px; border-radius: 50%; background: radial-gradient(#c0222f66, transparent 70%); }
      .flame { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: #ffffff14; }
      .chips { display: flex; gap: 6px; position: relative; z-index: 1; }
      .chips span { padding: 3px 8px; border-radius: 99px; background: #ffffff1a; font-size: 11px; font-weight: 500; }

      .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px 10px; }
      .icon { display: grid; justify-items: center; gap: 6px; color: #fff; }
      .icon .name { color: var(--ink); }
      .tile {
        position: relative; width: 62px; height: 62px; border-radius: 16px; display: grid; place-items: center;
        background: linear-gradient(160deg, color-mix(in srgb, var(--c) 80%, #fff), var(--c)); box-shadow: 0 6px 14px -8px #0006;
        transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
      }
      .icon:active .tile { transform: scale(0.92); }
      .badge {
        position: absolute; top: -6px; right: -10px; padding: 2px 6px; border-radius: 99px; background: var(--ink); color: #fff;
        font: 600 10px/1.2 Inter, sans-serif; font-style: normal; box-shadow: 0 2px 6px #0003;
      }
      .name { font-size: 12px; font-weight: 500; white-space: nowrap; }

      .notes { display: grid; gap: 8px; }
      .n { display: grid; grid-template-columns: 34px 1fr; gap: 10px; align-items: start; padding: 10px 12px; border-radius: 16px; background: var(--bg); text-align: left; transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
      .n:active { transform: scale(0.98); }
      .n-ic { width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; color: #fff; background: var(--c); }
      .n-txt { display: grid; min-width: 0; }
      .n-row { display: flex; justify-content: space-between; color: var(--muted); }
      .n-txt small { font-size: 12px; }
      .n-txt b { font-size: 14px; font-weight: 600; }
      .n-txt > small { color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      .dock { margin-top: auto; display: grid; justify-items: center; gap: 10px; }
      .search { display: flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 99px; background: var(--bg); color: var(--muted); font-size: 14px; }
      .dots { display: flex; gap: 6px; }
      .dots i { width: 6px; height: 6px; border-radius: 50%; background: #d4d5d9; }
      .dots i.on { background: var(--ink); }

      /* Inside an app: a coloured header with the app's name and what it does */
      .app { display: flex; flex-direction: column; height: 100%; background: var(--bg); overflow: hidden; }
      .app-top { padding: 4px 16px 18px; color: #fff; background: linear-gradient(160deg, var(--a), color-mix(in srgb, var(--a) 70%, #000)); border-radius: 0 0 24px 24px; }
      .app-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
      .back { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: #ffffff26; color: #fff; font-size: 24px; line-height: 1; padding-bottom: 3px; }
      .app-title { display: flex; gap: 12px; align-items: center; }
      .app-title div { display: grid; }
      .app-title b { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }
      .app-title small { font-size: 13px; opacity: 0.85; }
      .app-ic { width: 44px; height: 44px; border-radius: 13px; display: grid; place-items: center; background: #ffffff2b; }
      .pill { padding: 4px 10px; border-radius: 99px; background: #ffffff2b; color: #fff; font-size: 12px; font-weight: 600; }
      .idea-note { display: flex; gap: 8px; align-items: center; margin: 14px 14px 0; padding: 9px 12px; border-radius: 12px; background: #fdf3dc; color: #6e4b06; font-size: 13px; }
      .idea-note b { padding: 2px 7px; border-radius: 99px; background: #e3a42b; color: #fff; font-size: 11px; }
      .app-body { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 12px; min-height: 0; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 14px; display: grid; gap: 10px; }
      .card.center { justify-items: center; text-align: center; }
      .stack { display: grid; justify-items: center; gap: 6px; margin-top: 6px; }
      .card p { margin: 0; }
      .row { display: flex; justify-content: space-between; align-items: baseline; }
      .total b { font-size: 22px; }
      .muted { color: var(--muted); }
      .small { font-size: 13px; margin: 0 4px; }
      .ok { color: var(--ok); font-weight: 500; }
      .big { font-size: 40px; line-height: 1.1; }
      .accent { color: var(--a); }
      .btn { padding: 13px; border-radius: 12px; background: var(--a); color: #fff; font-weight: 600; transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
      .btn:active { transform: scale(0.97); }
      .btn.ghost { background: color-mix(in srgb, var(--a) 12%, #fff); color: var(--a); }
      .opts { display: grid; gap: 6px; }
      .opt { display: flex; justify-content: space-between; padding: 11px 12px; border: 1.5px solid var(--line); border-radius: 12px; background: #fff; text-align: left; }
      .opt.on { border-color: var(--a); background: color-mix(in srgb, var(--a) 7%, #fff); }
      .opt:disabled { opacity: 0.55; cursor: default; }
      .stepper { display: flex; align-items: center; justify-content: space-between; }
      .stepper button { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--bg); }
      .stepper b { font-size: 22px; }
      .track { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); font-size: 12px; color: var(--muted); }
      .track li { display: grid; justify-items: center; gap: 6px; position: relative; }
      .track li::before { content: ''; position: absolute; top: 6px; left: -50%; width: 100%; height: 2px; background: var(--line); }
      .track li:first-child::before { display: none; }
      .track i { width: 14px; height: 14px; border-radius: 50%; background: var(--line); z-index: 1; }
      .track .done, .track .now { color: var(--ink); }
      .track .done i, .track .done::before, .track .now::before { background: var(--a); }
      .track .now i { background: #fff; border: 3px solid var(--a); }

      /* Messenger chat */
      .app:has(.chat) .app-body { padding: 0; gap: 0; background: #fff; }
      .chat { flex: 1; overflow-y: auto; padding: 12px 14px; display: flex; flex-direction: column; gap: 6px; min-height: 0; }
      .msg { margin: 0; max-width: 80%; padding: 9px 13px; border-radius: 18px; background: #f0f0f2; white-space: pre-line; align-self: flex-start; animation: pop 220ms cubic-bezier(0.23, 1, 0.32, 1); }
      .msg.me { align-self: flex-end; background: #0a7cff; color: #fff; }
      .typing { display: flex; gap: 4px; padding: 13px 14px; }
      .typing i { width: 7px; height: 7px; border-radius: 50%; background: #a3a6ad; animation: blink 1s infinite; }
      .typing i:nth-child(2) { animation-delay: 0.15s; }
      .typing i:nth-child(3) { animation-delay: 0.3s; }
      .sys-note { margin: 8px 0 0; align-self: center; text-align: center; font-size: 12px; color: var(--muted); }
      .quick { display: flex; justify-content: flex-end; padding: 10px 14px 14px; border-top: 1px solid var(--line); min-height: 62px; }
      .quick button { padding: 9px 14px; border-radius: 99px; border: 1.5px solid #0a7cff; color: #0a7cff; font-weight: 500; font-size: 14px; }
      @keyframes pop { from { opacity: 0; transform: translateY(6px) scale(0.97); } }
      @keyframes blink { 50% { opacity: 0.3; } }

      /* Prices */
      .prices { list-style: none; margin: 0; padding: 0; background: #fff; border: 1px solid var(--line); border-radius: 16px; }
      .prices li { display: grid; grid-template-columns: 1fr auto 46px 36px; align-items: center; gap: 8px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
      .prices li:last-child { border-bottom: 0; }
      .prices small { font-size: 12px; text-align: right; }
      .up { color: var(--ember); }
      .down { color: var(--ok); }
      .watch { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; color: var(--muted); }
      .watch.on { background: color-mix(in srgb, var(--a) 14%, #fff); color: var(--a); }

      .toast {
        position: fixed; left: 50%; top: 52px; width: calc(100% - 24px); transform: translate(-50%, -12px); opacity: 0; z-index: 9; pointer-events: none;
        padding: 12px 14px; border-radius: 16px; background: #ffffffee; box-shadow: 0 10px 30px -10px #0006; font-size: 14px;
        transition: opacity 220ms, transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
      }
      .toast.in { opacity: 1; transform: translate(-50%, 0); }
      @media (prefers-reduced-motion: reduce) { .msg, .typing i { animation: none; } }
    </style>
  </body>
</html>
