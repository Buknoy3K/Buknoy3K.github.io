---
// The kiosk in the campfire scene shows this page: a self-service welcome screen, laid out for a portrait touch
// screen. Design only for now: nothing behind "Tap to start" yet. It also works on its own at /kiosk.
import { brand } from '../config/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Kiosk | {brand.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@500;700;900&family=Red+Hat+Mono:wght@500&family=Red+Hat+Text:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="kiosk">
      <div class="sysbar" aria-hidden="true">
        <span><i class="dot"></i>Online · Kiosk 01</span>
        <span class="sys-ic">
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0M12 19.5h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </span>
      </div>
      <header class="top">
        <span class="mark">
          <svg viewBox="0 0 24 24" width="44" height="44" aria-hidden="true">
            <path d="M12 2c1 4 5 6 5 11a5 5 0 0 1-10 0c0-2.5 1.4-4 2.6-5.2.3 1.6 1 2.6 2.2 3.2C11 8.6 11 5 12 2z" fill="var(--ember)" />
            <path d="M12 12c.6 1.6 2.2 2.4 2.2 4.4a2.2 2.2 0 0 1-4.4 0c0-1.2.6-1.9 1.2-2.5.1.6.4 1 .9 1.3-.2-1.1-.2-2.1.1-3.2z" fill="var(--resin)" />
          </svg>
          {brand.name}
        </span>
        <span class="clock"><b data-time>9:41</b><small data-date>Thursday, October 29</small></span>
      </header>

      <section class="welcome">
        <span class="status"><i></i>Open · Self-service</span>
        <h1>Welcome<span>.</span></h1>
        <p>Touch the screen to begin.</p>
      </section>

      <button class="start" type="button">
        <span class="start-txt">
          <small>Start here</small>
          <b>Tap to start</b>
        </span>
        <span class="go" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="56" height="56"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </button>

      <section class="info">
        <div class="cell">
          <small>We accept</small>
          <div class="chips"><span>GCash</span><span>Maya</span><span>Cash</span></div>
        </div>
        <div class="cell">
          <small>Language</small>
          <div class="chips"><span class="on">English</span><span>Tagalog</span></div>
        </div>
        <div class="cell">
          <small>Need help?</small>
          <b>Ask the staff at the counter</b>
        </div>
      </section>

      <footer class="foot">
        <span>{brand.location}</span>
        <span>Kiosk 01</span>
      </footer>
    </main>

    <script>
      const time = document.querySelector<HTMLElement>('[data-time]')!;
      const date = document.querySelector<HTMLElement>('[data-date]')!;
      const tick = () => {
        const now = new Date();
        time.textContent = now.toLocaleTimeString('en-PH', { hour: 'numeric', minute: '2-digit' });
        date.textContent = now.toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric' });
      };
      tick();
      setInterval(tick, 10_000);
    </script>

    <style is:global>
      :root {
        /* Fog, the site's warm off-white: light, but a step below the laptop's pure white so the laptop stays the hero */
        --bg: #e4e5de; --deep: #1a1f1c; --ink: #16191a; --muted: #6b7068; --line: #00000017; --soft: #0000000b;
        --night: #151a16; --pine: #1b4430; --resin: #e3a42b; --ember: #c0222f; --accent: #3ecf8e;
        --display: 'Red Hat Display', system-ui, sans-serif; --mono: 'Red Hat Mono', ui-monospace, monospace;
        color-scheme: light;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--ink); font: 400 30px/1.4 'Red Hat Text', system-ui, sans-serif; }
      button { font: inherit; color: inherit; border: 0; cursor: pointer; }

      /* Laid out for a 1080-wide portrait screen; the vertical rhythm stretches with its height */
      .kiosk {
        height: 100%; display: grid; grid-template-rows: auto auto 1fr auto auto auto; gap: 56px;
        padding: 0 72px 52px;
        background:
          radial-gradient(80% 45% at 100% 0%, #f1ede3, transparent 70%),
          radial-gradient(60% 35% at 0% 100%, #d8dad2, transparent 70%),
          radial-gradient(#00000012 1.5px, transparent 1.8px) 0 0 / 36px 36px,
          var(--bg);
      }

      .sysbar {
        display: flex; justify-content: space-between; align-items: center; margin: 0 -72px -16px; padding: 18px 40px;
        border-bottom: 1.5px solid var(--line); background: #ffffff59;
        font: 500 18px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
      }
      .sysbar span { display: inline-flex; align-items: center; gap: 10px; }
      .sysbar .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
      .sys-ic { gap: 14px; }
      .top { display: flex; justify-content: space-between; align-items: center; }
      .mark { display: inline-flex; align-items: center; gap: 14px; font: 700 34px/1 var(--display); }
      .clock { display: grid; justify-items: end; gap: 6px; }
      .clock b { font: 500 40px/1 var(--display); letter-spacing: -0.01em; }
      .clock small { font-size: 22px; color: var(--muted); }

      .welcome { align-self: center; }
      .status {
        display: inline-flex; align-items: center; gap: 12px; padding: 12px 22px; border: 1.5px solid var(--line); border-radius: 99px;
        font: 500 20px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
      }
      .status i { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); animation: pulse 2.4s infinite; }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 #3ecf8e80; }
        70%, 100% { box-shadow: 0 0 0 12px #3ecf8e00; }
      }
      h1 { margin: 40px 0 0; font: 900 210px/0.86 var(--display); letter-spacing: -0.045em; }
      h1 span { color: var(--ember); }
      .welcome p { margin: 32px 0 0; font-size: 46px; line-height: 1.2; color: var(--muted); }

      .start {
        position: relative; display: flex; justify-content: space-between; align-items: center; width: 100%;
        padding: 56px 56px 56px 64px; border-radius: 40px; background: var(--deep); color: #eeede6;
        box-shadow: 0 30px 60px -30px #1a1f1c80; text-align: left;
        overflow: hidden;
        transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
      }
      .start::before { content: ''; position: absolute; right: -120px; top: -160px; width: 520px; height: 520px; border-radius: 50%; background: radial-gradient(#e3a42b33, transparent 68%); }
      .start:active { transform: scale(0.985); }
      .start-txt { position: relative; display: grid; gap: 10px; }
      .start small { font: 500 22px/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: #9a9f96; }
      .start b { font: 700 76px/1 var(--display); letter-spacing: -0.03em; }
      .go {
        position: relative; display: grid; place-items: center; width: 132px; height: 132px; border-radius: 50%; background: var(--resin); color: var(--deep);
      }
      .go::after { content: ''; position: absolute; inset: -10px; border-radius: 50%; border: 2px solid #e3a42b80; animation: ring 2.4s cubic-bezier(0.23, 1, 0.32, 1) infinite; }
      @keyframes ring { from { transform: scale(0.9); opacity: 1; } to { transform: scale(1.25); opacity: 0; } }

      .info { display: grid; grid-template-columns: 1.25fr 1fr 1fr; border: 1.5px solid var(--line); border-radius: 28px; }
      .cell { display: grid; align-content: start; gap: 14px; padding: 28px 30px; }
      .cell + .cell { border-left: 1.5px solid var(--line); }
      .cell small { font: 500 18px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      .cell b { font-size: 26px; font-weight: 500; line-height: 1.25; }
      .chips { display: flex; flex-wrap: wrap; gap: 8px; }
      .chips span { padding: 8px 14px; border-radius: 99px; background: var(--soft); font-size: 22px; font-weight: 500; }
      .chips .on { background: var(--ink); color: var(--bg); }

      .foot {
        display: flex; justify-content: space-between; padding-top: 24px; border-top: 1.5px solid var(--line);
        font: 500 18px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: #8b8f87;
      }

      @media (prefers-reduced-motion: reduce) {
        .status i, .go::after { animation: none; }
      }
    </style>
  </body>
</html>
