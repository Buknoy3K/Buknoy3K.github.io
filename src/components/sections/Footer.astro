---
import { brand, products } from '../../config/site';
import credits from '../../assets/world/credits.json';

// The name, built from blocks: each letter is knocked out of its own colour block.
const blocks = [
  ['S', 'var(--resin)', 100],
  ['A', 'var(--pine-4)', 76],
  ['L', 'var(--ember)', 88],
  ['E', 'var(--fog-2)', 64],
  ['N', 'var(--accent)', 94],
  ['G', 'var(--resin-2)', 82],
] as const;

const columns = [
  { title: 'Chapters', links: [['Problem', '/#problem'], ['How it works', '/#how'], ['Market', '/#market'], ['Pricing', '/#model']] },
  { title: 'Products', links: products.map((p) => [p.name, `/products/${p.slug}`]) },
  { title: 'Company', links: [['Roadmap', '/#roadmap'], ['Team', '/#team'], ['Contact', '/#contact']] },
];
const placeholderEmail = brand.email.endsWith('example.com');
---

<footer class="field field-night foot" data-chapter="night">
  <div class="wrap">
    <svg class="mark" viewBox="0 0 604 100" role="img" aria-label={brand.name}>
      <defs>
        {blocks.map(([, , height], i) => (
          <clipPath id={`block-${i}`}><rect x={i * 101} y={100 - height} width="98" height={height} /></clipPath>
        ))}
      </defs>
      {blocks.map(([letter, color, height], i) => (
        <g clip-path={`url(#block-${i})`}>
          <rect x={i * 101} y={100 - height} width="98" height={height} fill={color} />
          <text x={i * 101 + 49} y="108" text-anchor="middle">{letter}</text>
        </g>
      ))}
    </svg>

    <div class="cols">
      {columns.map((c) => (
        <div>
          <h2>{c.title}</h2>
          <ul>{c.links.map(([label, href]) => <li><a href={href} class="flink">{label}</a></li>)}</ul>
        </div>
      ))}
      <div class="contact">
        <h2>{brand.name}</h2>
        <p>{brand.description}</p>
        <p>{brand.location}</p>
        {!placeholderEmail && <p><a href={`mailto:${brand.email}`} class="flink">{brand.email}</a></p>}
      </div>
    </div>

    <div class="last">
      <span>© {new Date().getFullYear()} {brand.name}</span>
      <a href="#top" class="btn btn-light top">Back to top <span class="arrow" aria-hidden="true">↑</span></a>
    </div>

    <p class="credits">
      Photographs:{' '}
      {credits.map((c, i) => (
        <>
          {i > 0 && '; '}
          <a href={c.page}>“{c.title}”</a> by {c.creator}, {c.license}, via {c.via}
        </>
      ))}.
    </p>
  </div>
</footer>

<style>
  .foot { padding: clamp(72px, 8vw, 120px) 0 40px; }
  .mark { display: block; width: 100%; height: auto; max-height: 34svh; }
  .mark text { font: 900 122px var(--display); fill: var(--night); letter-spacing: -0.04em; }

  .cols {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
  }
  .cols > div { grid-column: span 2; }
  .cols > .contact { grid-column: 9 / 13; display: grid; gap: 8px; align-content: start; }
  h2 { font: 500 var(--step-small)/1.3 var(--text); text-transform: none; letter-spacing: 0; color: var(--soft); margin-bottom: 12px; }
  ul { display: grid; gap: 8px; }
  .flink, .contact p { font-size: var(--step-small); }
  .flink { text-decoration: none; }
  @media (hover: hover) and (pointer: fine) {
    .flink:hover { text-decoration: underline 2px; text-underline-offset: 4px; }
  }

  .last { margin-top: 64px; display: flex; justify-content: space-between; align-items: center; gap: 16px; font-size: var(--step-small); }
  .top { min-height: 40px; padding: 0 16px; font-size: var(--step-small); }
  .credits { margin-top: 32px; font-size: var(--step-small); color: var(--soft); max-width: 62ch; }
  .credits a { color: inherit; }

  @media (max-width: 760px) {
    .cols > div { grid-column: span 6; }
    .cols > .contact { grid-column: 1 / -1; }
  }
</style>
