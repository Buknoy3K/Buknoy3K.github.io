---
import { Image } from 'astro:assets';
import { hero, problems, problemHead } from '../../config/site';
import store from '../../assets/world/typical-sari-sari-store.jpg';
import prices from '../../assets/world/sari-sari-store-cavite.jpg';

const photos = [
  { src: store, alt: 'A sari-sari store hung with sachets, prices written by hand on cardboard', caption: 'Prices on cardboard' },
  { src: prices, alt: 'Two shopkeepers behind a counter with hand-lettered price cards', caption: 'Prices by hand' },
];
---

<section class="field field-night chapter problem" id="problem" data-chapter="night">
  <div class="wrap grid">
    <p class="phone-intro">{hero.text}</p>
    <h2 class="h2" data-rise>{problemHead.title}</h2>

    <p class="stairs" data-rise>
      {problemHead.text.map((line, i) => <span style={`--step:${i}`}>{line} </span>)}
    </p>

    <div class="photos">
      {photos.map((p) => (
        <figure data-unveil>
          <Image src={p.src} alt={p.alt} widths={[400, 700]} sizes="(max-width: 760px) 50vw, 22vw" class="pic" />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>

    <ul class="problems">
      {problems.map((p) => (
        <li data-rise>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0 24px;
  }
  .phone-intro { display: none; }
  .h2 { grid-column: 1 / 9; grid-row: 1; }
  .stairs {
    grid-column: 1 / 10;
    grid-row: 2;
    margin-top: clamp(48px, 6vw, 88px);
    font: 900 var(--step-title)/1.08 var(--display);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .stairs span { display: block; padding-left: calc(var(--step) * 6%); }
  .stairs span:nth-child(odd) { color: var(--resin); }

  .photos {
    grid-column: 10 / 13;
    grid-row: 1 / 3;
    display: grid;
    gap: 16px;
    align-content: start;
  }
  figure { margin: 0; }
  .pic { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  figcaption { margin-top: 8px; font-size: var(--step-small); color: var(--soft); }

  .problems {
    grid-column: 1 / -1;
    grid-row: 3;
    margin-top: clamp(64px, 8vw, 120px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .problems h3 { font-size: var(--step-lead); line-height: 1; letter-spacing: -0.02em; }
  .problems p { margin-top: 14px; max-width: 40ch; }

  @media (max-width: 960px) {
    .h2 { grid-column: 1 / -1; }
    .stairs { grid-column: 1 / -1; }
    .photos { grid-column: 1 / -1; grid-row: 3; grid-template-columns: 1fr 1fr; margin-top: 48px; }
    .problems { grid-row: 4; grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 760px) {
    .phone-intro { display: block; grid-column: 1 / -1; font-size: var(--step-lead); line-height: 1.35; margin-bottom: 72px; }
    .h2 { grid-row: 2; }
    .stairs { grid-row: 3; font-size: 6vw; }
    .stairs span { padding-left: calc(var(--step) * 5vw); }
    .photos { grid-row: 4; gap: 8px; }
    .problems { grid-row: 5; }
  }
</style>
