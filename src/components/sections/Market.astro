---
import { market } from '../../config/site';
import { ph } from '../../lib/ph';

// Tall, middle and short tiles: the market narrows from the whole country to Benguet.
const fields = ['night', 'fog', 'pine'];
---

<section class="field field-resin chapter market" id="market" data-chapter="resin">
  <div class="wrap grid">
    {market.tiers.map((t, i) => (
      <div class={`tile tile-${i} field field-${fields[i]}`} data-rise>
        <div class="value" set:html={ph(t.value)} />
        <p class="caption"><strong>{t.label}</strong> <span set:html={ph(t.text)} /></p>
      </div>
    ))}

    <div class="head" data-rise>
      <h2>{market.title}</h2>
      <p>{market.text}</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto;
    gap: 8px;
    align-items: start;
  }
  .tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
  }
  .tile-0 { grid-column: 1 / 7; grid-row: 1 / 3; height: 70vh; min-height: 480px; }
  .tile-1 { grid-column: 7 / 10; grid-row: 2; height: 44vh; min-height: 300px; }
  .tile-2 { grid-column: 10 / 13; grid-row: 2; height: 34vh; min-height: 240px; margin-top: 12vh; }
  .value {
    font: 900 var(--step-head)/0.95 var(--display);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .tile-1 .value, .tile-2 .value { font-size: var(--step-title); }
  .caption { font-size: var(--step-body); max-width: 34ch; }

  .head { grid-column: 7 / 13; grid-row: 1; padding: 0 0 clamp(32px, 5vh, 64px) 16px; }
  .head h2 { font-size: var(--step-title); line-height: 1; }
  .head p { margin-top: 16px; max-width: 44ch; }


  @media (max-width: 960px) {
    .head { grid-column: 1 / -1; grid-row: 1; padding: 0 0 32px; }
    .tile-0 { grid-column: 1 / -1; grid-row: 2; height: 56vw; min-height: 300px; }
    .tile-1 { grid-column: 1 / 7; grid-row: 3; height: auto; min-height: 220px; }
    .tile-2 { grid-column: 7 / 13; grid-row: 3; height: auto; min-height: 220px; margin-top: 32px; }
  }
  @media (max-width: 760px) {
    .tile { padding: 18px; }
    .tile-0 .value { font-size: 13vw; }
    .tile-1 .value, .tile-2 .value { font-size: 7.4vw; }
    .caption { font-size: var(--step-small); }
  }
</style>
