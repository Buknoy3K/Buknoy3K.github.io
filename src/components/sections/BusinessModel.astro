---
import { pricing } from '../../config/site';
import { ph } from '../../lib/ph';

// Plans step up like a bar chart, smallest first, so the bigger plan is literally bigger.
const steps = [
  { name: 'Automation add-on', field: 'resin', strip: 'var(--resin-2)' },
  { name: 'Starter', field: 'pine', strip: 'var(--pine-1)' },
  { name: 'Custom', field: 'ember', strip: 'var(--ember-2)' },
];
const plans = steps
  .map((s) => ({ ...s, tier: pricing.tiers.find((t) => t.name === s.name)! }))
  .filter((p) => p.tier);
---

<section class="field field-fog chapter model" id="model" data-chapter="fog">
  <div class="wrap">
    <div class="board">
      <h2 data-rise>{pricing.title}</h2>
      {plans.map((p, i) => (
        <div class={`plan plan-${i} field field-${p.field}`} style={`--strip:${p.strip}`} data-rise>
          <div class="plan-body">
            <h3>{p.tier.name}</h3>
            <div class="price" set:html={ph(p.tier.price)} />
            <p class="unit">{p.tier.unit} <span set:html={ph(p.tier.monthly)} /></p>
            <ul>
              {p.tier.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
          <a href="#contact" class="strip">Ask about {p.tier.name} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>

    <div class="after" data-rise>
      <p class="lead">{pricing.text}</p>
      <p class="streams"><strong>Revenue:</strong> {pricing.streams.join(' + ')}</p>
    </div>
  </div>
</section>

<style>
  /* The heading takes the space above the two shorter plans; the tallest plan rises beside it */
  .board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 8px;
    align-items: end;
  }
  h2 { grid-column: 1 / 3; grid-row: 1; align-self: start; font-size: var(--step-head); padding-bottom: 32px; }
  .plan-0 { grid-column: 1; grid-row: 2; }
  .plan-1 { grid-column: 2; grid-row: 2; }
  .plan-2 { grid-column: 3; grid-row: 1 / 3; }
  .plan { display: flex; flex-direction: column; justify-content: space-between; }
  .plan-0 { height: 420px; }
  .plan-1 { height: 540px; }
  .plan-2 { height: 660px; }
  .plan-body { padding: 28px; }
  h3 { font-size: var(--step-title); line-height: 1; }
  .price { margin-top: 12px; font: 900 var(--step-title)/1 var(--display); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .unit { margin-top: 8px; font-weight: 500; }
  ul { margin-top: 20px; display: grid; gap: 6px; font-size: var(--step-body); }
  .strip {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 28px;
    background: var(--strip);
    font-weight: 500;
    text-decoration: none;
    transition: transform 160ms var(--ease-out);
  }
  .strip:active { transform: scale(0.98); }
  .strip .arrow { transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .strip:hover .arrow { transform: translateX(4px); }
  }

  .after {
    margin-top: 64px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }
  .streams { font-size: var(--step-body); max-width: 60ch; }

  @media (max-width: 960px) {
    .board { grid-template-columns: 1fr; grid-template-rows: none; align-items: stretch; }
    h2 { grid-column: 1; padding-bottom: 24px; font-size: min(var(--step-head), 8.6vw); }
    .plan-0, .plan-1, .plan-2 { grid-column: 1; grid-row: auto; }
    .plan-0, .plan-1, .plan-2 { height: auto; }
    .plan-body { padding: 22px 22px 32px; }
    .price { font-size: var(--step-title); }
    .after { grid-template-columns: 1fr; }
  }
</style>
